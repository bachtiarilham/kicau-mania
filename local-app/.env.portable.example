# Windows portable API; frontend is provided separately.
ENGINE_ACCESS_MODE=lan
HTTP_ADDR=0.0.0.0:8090
API_TOKEN=
APP_ENV=production
SERVICE_NAME=local-app
LOG_DIR=./logs
DATA_DIR=./data
RUNTIME_DIR=./runtime
FFMPEG_BIN=./bin/ffmpeg.exe
FFPROBE_BIN=./bin/ffprobe.exe
MEDIAMTX_BIN=./bin/mediamtx.exe
ARENA_ID=arena01
ENGINE_ID=engine01
CHANNELS_JSON=[]
RESTREAM_TARGETS_JSON={}
RTSP_ADDR=127.0.0.1:8554
RTSP_BASE_URL=rtsp://127.0.0.1:8554
WEBRTC_ADDR=127.0.0.1:8889
WEBRTC_PUBLIC_URL=http://127.0.0.1:8090
WEBRTC_LOCAL_UDP_ADDR=:8189
WEBRTC_HOSTS=127.0.0.1
# Allow only loopback frontend origins for operator control.
ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:3000,http://127.0.0.1:3000
# The selected subnet is applied to the runtime after setup succeeds.
MEDIA_READ_CIDRS=127.0.0.1/32,::1/128
MAX_ROUND_DURATION=1h
MIN_FREE_BYTES=5368709120
AUDIO_ACTIVE_DBFS=-35
