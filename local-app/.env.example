# Copy to .env; replace token, source URLs, IPs, and secrets before running.
# Run from local-app. Existing environment variables override this file.
# Keep existing cloud-ticket access. For standalone LAN setup API use .env.portable.example.
ENGINE_ACCESS_MODE=cloud
HTTP_ADDR=127.0.0.1:8090
# Logging follows park-server-v3: colored development console, JSON production/file.
APP_ENV=development
SERVICE_NAME=local-app
LOG_DIR=./logs
API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATA_DIR=./data
RUNTIME_DIR=./runtime
# Engine identity and outbound cloud communication.
ARENA_ID=arena01
ENGINE_ID=engine01
CLOUD_COMMANDS_URL=
CLOUD_HEARTBEAT_URL=
CLOUD_MEDIA_UPDATES_URL=
CLOUD_PLAYBACK_AUTHORIZE_URL=
HEARTBEAT_INTERVAL=5s
HEARTBEAT_TIMEOUT=15s
CLOUD_ENGINE_TOKEN=
# Use .env.lan.example and scripts/configure-lan.ps1 for LAN HTTPS/DNS.
FRONTEND_ORIGIN=
LOCAL_PUBLIC_URL=
LAN_SERVER_IP=
DNS_LISTEN_ADDR=
DNS_UPSTREAMS=1.1.1.1:53,8.8.8.8:53
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Validated configuration schema: MediaMTX v1.15.3
MEDIAMTX_BIN=mediamtx
RTSP_ADDR=127.0.0.1:8554
RTSP_BASE_URL=rtsp://127.0.0.1:8554
WEBRTC_ADDR=127.0.0.1:8889
WEBRTC_LOCAL_UDP_ADDR=:8189
WEBRTC_PUBLIC_URL=http://127.0.0.1:8090
WEBRTC_HOSTS=192.168.10.2
ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:3000,http://192.168.10.2:3000
MEDIA_READ_CIDRS=127.0.0.1/32,::1/128,192.168.10.0/24

# Explicit ZiTech/NVR URLs; do not assume a vendor-specific RTSP path.
CHANNELS_JSON='[{"id":"lapak01","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_01"},{"id":"lapak02","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_02"},{"id":"lapak03","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_03"},{"id":"lapak04","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_04"},{"id":"lapak05","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_05"},{"id":"lapak06","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_06"},{"id":"lapak07","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_07"},{"id":"lapak08","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_08"},{"id":"lapak09","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_09"},{"id":"lapak10","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_10"},{"id":"lapak11","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_11"},{"id":"lapak12","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_12"},{"id":"lapak13","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_13"},{"id":"lapak14","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_14"},{"id":"lapak15","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_15"},{"id":"lapak16","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_16"},{"id":"lapak17","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_17"},{"id":"lapak18","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_18"},{"id":"lapak19","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_19"},{"id":"lapak20","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_20"},{"id":"lapak21","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_21"},{"id":"lapak22","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_22"},{"id":"lapak23","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_23"},{"id":"lapak24","source":"rtsp://REPLACE_USER:REPLACE_PASSWORD@192.168.10.10:554/REPLACE_RTSP_PATH_24"}]'

AUDIO_ACTIVE_DBFS=-35
MAX_ROUND_DURATION=1h
MIN_FREE_BYTES=5368709120

# Disabled until targets are configured; one simultaneous stream per target.
# Example: {"youtube":"rtmps://a.rtmps.youtube.com/live2/STREAM_KEY","cloud":"rtsp://user:pass@cloud.example:8554/arena"}
RESTREAM_TARGETS_JSON='{}'

# Optional backend: POST one metric JSON object; 2xx acknowledges receipt.
BACKEND_METRICS_URL=
BACKEND_TOKEN=

# Optional S3-compatible upload. Empty bucket keeps completed jobs READY locally.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

