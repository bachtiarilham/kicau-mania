# Deployment settings; configure-lan merges these with a source .env/.env.webcam.
# All deployment-specific values are customizable. Never commit .env.lan.
ARENA_ID=arena01
APP_ENV=production
SERVICE_NAME=local-app
LOG_DIR=./logs
ENGINE_ID=engine01
FRONTEND_ORIGIN=https://dev.megaallstararena.com
LOCAL_PUBLIC_URL=https://lan-dev.megaallstararena.com
LAN_SERVER_IP=192.168.2.151
LAN_READ_CIDR=192.168.2.0/24
HOSTING_PROVIDER=hostinger
DNS_PROVIDER=hostinger
ROUTER_VENDOR=tp-link
ROUTER_MODEL=archer-c6
DNS_UPSTREAMS=1.1.1.1:53,8.8.8.8:53
CADDY_BIN=./bin/caddy.exe
ACME_EMAIL=
HOSTINGER_API_TOKEN=
# Persistent files, including the arena DB and Caddy certificates.
DATA_DIR=./data/lan
RUNTIME_DIR=./runtime/lan-app
# Configure a different physical disk, USB disk, or mounted backup share.
BACKUP_DIR=
# Optional cloud receiver endpoint. Empty means queue locally indefinitely.
CLOUD_SYNC_URL=
CLOUD_COMMANDS_URL=
CLOUD_PACKAGES_URL=
CLOUD_ENGINE_TOKEN=
