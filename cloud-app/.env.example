# Copy to .env; process environment overrides this file, including empty values.
HTTP_ADDR=127.0.0.1:8091
APP_ENV=development
SERVICE_NAME=cloud-app
LOG_DIR=./logs
ALLOWED_ORIGINS=https://dev.megaallstararena.com
HTTP_REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
# Required for business features. Empty keeps liveness up and readiness at 503.
# Example: postgres://cloud_service:YOUR_PASSWORD@127.0.0.1:5432/kicau?sslmode=disable
# For remote production databases configure trusted TLS (for example sslmode=verify-full).
DATABASE_URL=
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s
DB_HEALTH_TIMEOUT=2s

# Browser and authentication. Use a loopback HTTP origin for local development.
FRONTEND_PUBLIC_URL=https://dev.megaallstararena.com
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Opaque tokens require Redis; empty/unreachable yields readiness and auth 503.
# rediss:// for a remote TLS-protected Redis deployment.
REDIS_URL=redis://127.0.0.1:6379/0

# Optional private desktop recording storage (S3 / MinIO)
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=

# WhatsApp Delivery Gateway (Fonnte, Waha, Wablas, or Custom Webhook)
WHATSAPP_ENDPOINT=
WHATSAPP_API_KEY=
