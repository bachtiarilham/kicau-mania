APP_ENV=production
SERVICE_NAME=cloud-app
HTTP_ADDR=0.0.0.0:8091
DATABASE_URL=postgres://cloud_service:URL_ENCODED_SERVICE_PASSWORD@postgres:5432/kicau_mania?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s
DB_HEALTH_TIMEOUT=2s
HTTP_REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
ALLOWED_ORIGINS=https://dev.megaallstararena.com
FRONTEND_PUBLIC_URL=https://dev.megaallstararena.com
TRUSTED_PROXIES=172.30.20.2/32
REDIS_URL=redis://redis:6379/0

# Optional private desktop recording storage (migration 011).
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
